{
  "name": "treasure-rush",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:server && node dist/server/index.js",
    "build": "npm run typecheck && vite build --configLoader runner && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test dist-tests/tests/engine.test.js dist-tests/tests/network.test.js",
    "test:e2e": "playwright test",
    "test:deployed": "node scripts/smoke.mjs",
    "ai:plan": "npm run build:server && node dist/scripts/agents.js"
  },
  "dependencies": {
    "@openai/agents": "^0.3.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "openai": "^6.0.0",
    "pg": "^8.16.0",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
